# Application Configuration
APP_ENV=development
APP_NAME="AI Virtual Outfit Preview"
DEBUG=true
API_PORT=8000

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=virtual_outfit_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev@postgres:5432/virtual_outfit_db

# Message Broker Configuration (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage Configuration
STORAGE_LOCAL_PATH=/app/data_storage
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_MIN_DIMENSION_PX=64
UPLOAD_MAX_DIMENSION_PX=4096
UPLOAD_MAX_PIXELS=16777216

# AI Provider & Worker Configuration ("fake", "huggingface", or "fal")
TASK_PUBLISHER_BACKEND=celery
AI_PROVIDER=huggingface
FAKE_AI_PROCESSING_DELAY_SECONDS=0.0
WORKER_MAX_RETRIES=2
WORKER_RETRY_BACKOFF_SECONDS=2

# Hugging Face Space Provider (Free ZeroGPU via gradio_client)
HF_TOKEN=
HF_SPACE_ID=yisol/IDM-VTON
HF_API_NAME=/tryon
HF_GARMENT_DESCRIPTION="Upper body garment"
HF_AUTO_MASK=true
HF_AUTO_CROP=false
HF_DENOISE_STEPS=30
HF_SEED=42
HF_TIMEOUT_SECONDS=180.0

# fal.ai Provider
FAL_KEY=
FAL_MODEL_ID=fal-ai/cat-vton
FAL_CLOTH_TYPE=upper
FAL_HTTP_TIMEOUT_SECONDS=30.0
FAL_POLL_INTERVAL_SECONDS=2.0
FAL_POLL_TIMEOUT_SECONDS=180.0
FAL_DOWNLOAD_MAX_RETRIES=3
FAL_DOWNLOAD_RETRY_BACKOFF_SECONDS=1.0
