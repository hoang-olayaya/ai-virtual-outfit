# Infrastructure environment configuration template
# Copy this file to .env at root or in infrastructure/

APP_ENV=development
APP_NAME="AI Virtual Outfit Preview"
DEBUG=true
API_PORT=8000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_DB=virtual_outfit_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_dev@postgres:5432/virtual_outfit_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Storage
STORAGE_LOCAL_PATH=/app/data_storage

# fal.ai
FAL_KEY=
